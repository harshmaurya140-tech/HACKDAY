{
  "manifest_version": 3,
  "name": "Incognix",
  "version": "0.8.1",
  "description": "Local privacy review for any chatbot, with private composers on ChatGPT, Claude and Gemini. Development preview.",
  "minimum_chrome_version": "138",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "content/adapters.js",
        "content/session-navigation.js",
        "content/native-draft.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "private/frame.html"
      ],
      "matches": [
        "https://*/*"
      ]
    }
  ],
  "action": {
    "default_title": "Open Incognix private workspace",
    "default_popup": "private/popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "optional_host_permissions": [
    "https://*/*"
  ]
}
